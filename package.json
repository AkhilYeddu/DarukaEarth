{
  "name": "darukaa-earth",
  "version": "1.0.0",
  "description": "Geospatial Data Analytics Platform for Carbon & Biodiversity Projects",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "lint": "npm --prefix server run lint && npm --prefix client run lint",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "keywords": [
    "geospatial",
    "carbon-credits",
    "biodiversity",
    "remote-sensing",
    "mapbox",
    "highcharts",
    "mern"
  ],
  "author": "Darukaa.Earth Engineering Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
